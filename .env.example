# Grok (optional: without it Convene falls back to keyword extraction and tag-only matching)
XAI_API_KEY=
XAI_MODEL=grok-4.7

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of the deployment (used for QR codes and the MCP server_url)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
