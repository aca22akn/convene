# AI provider (optional: without it Convene falls back to keyword extraction and tag-only matching)
AI_PROVIDER_NAME=xAI
AI_API_KEY=
AI_BASE_URL=https://api.x.ai/v1
AI_MODEL=grok-4.20-0309-non-reasoning
AI_RERANK_MODEL=grok-4.20-0309-non-reasoning

# Legacy xAI names remain supported when the AI_* equivalent is unset.
XAI_API_KEY=
XAI_BASE_URL=
XAI_MODEL=
XAI_RERANK_MODEL=

# OpenAI example (set a real key separately; choose supported model names).
# AI_PROVIDER_NAME=OpenAI
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=<OpenAI model name>
# AI_RERANK_MODEL=<OpenAI model name>

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_ID_SECRET=

# Public URL of the deployment (used for QR codes and the MCP server_url)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

PERSON_KEY_PEPPER=
CRON_SECRET=
MAX_MEMBERS_PER_EVENT=200
AI_DAILY_CALL_LIMIT=3000
AI_EVENT_DAILY_CALL_LIMIT=400
JOIN_IP_LIMIT=8
JOIN_EVENT_LIMIT=400
EVENT_CREATE_IP_LIMIT=5
EVENT_CREATE_GLOBAL_LIMIT=200
IMPORT_LIMIT=6
ASK_MINUTE_LIMIT=5
ASK_HOUR_LIMIT=20
AUTH_EXCHANGE_LIMIT=10
EVENT_DELETE_LIMIT=5
RETENTION_DAYS=365
